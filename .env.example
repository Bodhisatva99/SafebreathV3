# GEMINI_API_KEY: Required if backend Gemini API routes are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Public Client Credentials (Vite browser env)
# Defaults are preconfigured for read-only live telemetry in src/lib/supabase.ts
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_ANON_KEY"
